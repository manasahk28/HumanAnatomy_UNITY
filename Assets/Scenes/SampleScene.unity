  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HumanAnatomy.AnatomyPart
  data:
    partName: Left Pectoralis Major
    scientificName: Musculus Pectoralis Major Sinister
    systemType: 7
    keyFunction: Powerful thick fan-shaped muscle covering upper anterior chest wall.
    description: Originates from medial clavicle, sternum, and 1st-6th costal cartilages; inserts onto lateral crest of greater tubercle of humerus.
    clinicalFacts:
    - 'Primary Action: Adduction, internal rotation, and forward flexion of arm.'
    - "Innervation: Medial and lateral pectoral nerves (C5\u2013T1)."
    - Forms anterior axillary fold framing armpit.
  baseColor: {r: 0.88, g: 0.21999997, b: 0.25999996, a: 1}
  hoverColor: {r: 1, g: 1, b: 1, a: 1}
  selectedColor: {r: 1, g: 0.95, b: 0.2, a: 1}
