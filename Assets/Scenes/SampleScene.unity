  m_EditorClassIdentifier: Assembly-CSharp::HumanAnatomy.AnatomyPart
  data:
    partName: Left Scapula (Shoulder Blade)
    scientificName: Scapula Sinistra
    systemType: 1
    keyFunction: Triangular flat posterior bone anchoring rotator cuff musculature and shoulder articulation.
    description: Features posterior scapular spine, acromion, coracoid process, and shallow glenoid fossa.
    clinicalFacts:
    - Glenoid cavity articulates with humeral head with exceptional range of motion.
    - Glides across thoracic wall along physiological scapulothoracic joint plane.
