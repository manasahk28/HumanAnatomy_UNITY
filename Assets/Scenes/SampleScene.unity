  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HumanAnatomy.AnatomyPart
  data:
    partName: Spinal Cord (Cervical to Lumbar)
    scientificName: Medulla Spinalis
    systemType: 5
    keyFunction: Primary cylindrical conduction cable transmitting sensory afferents and motor efferents between brain and body.
    description: "Features cervical enlargement (C4\u2013T1, upper limb plexus) and lumbar enlargement (T11\u2013L1, lower limb plexus)."
    clinicalFacts:
    - "Terminates at L1\u2013L2 vertebral level at conus medullaris."
    - Gives rise to 31 pairs of spinal nerves traversing intervertebral foramina.
  baseColor: {r: 1, g: 0.88, b: 0.19999996, a: 1}
  hoverColor: {r: 1, g: 1, b: 1, a: 1}
  selectedColor: {r: 0.2, g: 0.95, b: 1, a: 1}
