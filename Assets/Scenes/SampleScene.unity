  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HumanAnatomy.AnatomyPart
  data:
    partName: Left Biceps Brachii
    scientificName: Musculus Biceps Brachii Sinister
    systemType: 7
    keyFunction: Two-headed fusiform muscle spanning anterior upper arm between shoulder and elbow.
    description: Originates via long head (supraglenoid tubercle) and short head (coracoid process); inserts into radial tuberosity.
    clinicalFacts:
    - 'Primary Action: Most powerful forearm supinator; strong elbow flexor.'
    - "Innervation: Musculocutaneous nerve (C5\u2013C6)."
    - Long head tendon passes through intertubercular bicipital groove.
  baseColor: {r: 0.96, g: 0.31999996, b: 0.21999997, a: 1}
  hoverColor: {r: 1, g: 1, b: 1, a: 1}
  selectedColor: {r: 1, g: 0.95, b: 0.2, a: 1}
  dimmedColor: {r: 0.25, g: 0.25, b: 0.25, a: 0.25}
  hasHeartbeatPulse: 0
  pulseSpeed: 1.2
  pulseMagnitude: 0.04
  explodedOffset: {x: -0.35, y: 0, z: 0.25}
