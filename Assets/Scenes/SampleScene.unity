  m_EditorClassIdentifier: Assembly-CSharp::HumanAnatomy.AnatomyPart
  data:
    partName: Sacrum and Coccyx
    scientificName: Os Sacrum et Coccygis
    systemType: 1
    keyFunction: Shield-shaped triangular bone formed by 5 fused sacral and 4 fused coccygeal vertebrae.
    description: Locks firmly between iliac bones at bilateral sacroiliac joints, distributing axial load to pelvis.
    clinicalFacts:
    - Sacral canal houses the cauda equina nerve roots.
    - Four pairs of anterior and posterior sacral foramina transmit sacral nerves.
