  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6a92d41c1f18dfe44ad26397aa09c9ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HumanAnatomy.AnatomyPart
  data:
    partName: Trapezius (Upper Back & Neck)
    scientificName: Musculus Trapezius
    systemType: 7
    keyFunction: Large diamond/kite-shaped superficial muscle covering posterior neck and superior trunk.
    description: "Originates from external occipital protuberance, nuchal ligament, and C7\u2013T12 spinous processes; inserts into lateral clavicle, acromion, and spine of scapula."
    clinicalFacts:
    - 'Primary Action: Elevates, retracts, rotates, and depresses scapula; extends and laterally flexes neck.'
    - "Innervation: Spinal accessory nerve (Cranial Nerve XI) and C3\u2013C4 cervical plexus fibers."
    - Divided into upper (descending), middle (transverse), and lower (ascending) functional fibers.
  baseColor: {r: 0.65999997, g: 0.21999997, b: 0.37999994, a: 1}
  hoverColor: {r: 1, g: 1, b: 1, a: 1}
  selectedColor: {r: 1, g: 0.95, b: 0.2, a: 1}
  dimmedColor: {r: 0.25, g: 0.25, b: 0.25, a: 0.25}
  hasHeartbeatPulse: 0
