MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1188208228}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6a92d41c1f18dfe44ad26397aa09c9ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HumanAnatomy.AnatomyPart
  data:
    partName: Left Ulnar Nerve
    scientificName: Nervus Ulnaris Sinister
    systemType: 5
    keyFunction: "Medial peripheral nerve originating from medial cord (C8\u2013T1); 'musician's nerve' governing fine intrinsic hand coordination."
    description: Passes posterior to medial epicondyle of humerus in cubital tunnel ('funny bone'), entering hand via Guyon's canal.
    clinicalFacts:
    - 'Motor: Flexor carpi ulnaris, hypothenar muscles, all interossei, adductor pollicis, medial two lumbricals.'
    - Severe neuropathy results in characteristic 'claw hand' (Klumpke's deformity) deformity.
  baseColor: {r: 1, g: 0.92, b: 0.29999998, a: 1}
  hoverColor: {r: 1, g: 1, b: 1, a: 1}
  selectedColor: {r: 0.2, g: 0.95, b: 1, a: 1}
  dimmedColor: {r: 0.25, g: 0.25, b: 0.25, a: 0.25}
  hasHeartbeatPulse: 0
  pulseSpeed: 1.2
  pulseMagnitude: 0.04
  explodedOffset: {x: -0.4, y: 0, z: -0.1}
