  m_Script: {fileID: 11500000, guid: 6a92d41c1f18dfe44ad26397aa09c9ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HumanAnatomy.AnatomyPart
  data:
    partName: Brainstem (Midbrain, Pons, Medulla)
    scientificName: Truncus Encephali
    systemType: 5
    keyFunction: Vital neurological stalk connecting cerebral cortex to spinal cord; controls autonomous vegetative homeostasis.
    description: Houses reticular activating system (consciousness) and autonomic centers for respiration, heart rate, and blood pressure.
    clinicalFacts:
    - Gives origin to 10 of the 12 pairs of cranial nerves (III through XII).
    - Medulla oblongata features motor decussation where corticospinal tract fibers cross.
  baseColor: {r: 0.95, g: 0.8, b: 0.24999997, a: 1}
  hoverColor: {r: 1, g: 1, b: 1, a: 1}
  selectedColor: {r: 0.2, g: 0.95, b: 1, a: 1}
  dimmedColor: {r: 0.25, g: 0.25, b: 0.25, a: 0.25}
  hasHeartbeatPulse: 0
  pulseSpeed: 1.2
  pulseMagnitude: 0.04
  explodedOffset: {x: 0, y: 0.1, z: 0}
