  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HumanAnatomy.AnatomyPart
  data:
    partName: Right Foot and Ankle Bones
    scientificName: Ossa Pedis Dextri
    systemType: 1
    keyFunction: 'Biomechanical platform comprising 26 bones: 7 tarsals (including calcaneus & talus), 5 metatarsals, 14 phalanges.'
    description: Arranged into medial longitudinal, lateral longitudinal, and transverse shock-absorbing arches.
    clinicalFacts:
    - Talus bone bears full body weight and articulates with tibial and fibular mortise.
    - Calcaneus (heel bone) is largest tarsal bone, anchoring Achilles tendon (tendo calcaneus).
  baseColor: {r: 0.62, g: 0.65999997, b: 0.85, a: 1}
