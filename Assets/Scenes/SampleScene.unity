  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HumanAnatomy.AnatomyPart
  data:
    partName: Sympathetic Trunk (Autonomic Nervous System)
    scientificName: Truncus Sympathicus
    systemType: 5
    keyFunction: Bilateral paired chain of paravertebral sympathetic ganglia running alongside entire vertebral column.
    description: 'Coordinates fight-or-flight sympathetic physiological responses: accelerates heart rate, dilates bronchioles, inhibits digestion.'
    clinicalFacts:
    - Extends from base of skull to coccyx (uniting at ganglion impar).
    - Transmits preganglionic and postganglionic sympathetic visceral fibers.
  baseColor: {r: 0.95, g: 0.75, b: 0.14999998, a: 1}
  hoverColor: {r: 1, g: 1, b: 1, a: 1}
