MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1394555690}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6a92d41c1f18dfe44ad26397aa09c9ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HumanAnatomy.AnatomyPart
  data:
    partName: Left Gluteal Complex (Maximus & Medius)
    scientificName: Musculus Gluteus Sinister
    systemType: 7
    keyFunction: Heaviest and most massive muscle complex in human anatomy, essential for upright bipedal standing.
    description: Originates from posterior ilium, sacrum, and coccyx; inserts into gluteal tuberosity of femur and iliotibial (IT) tract.
    clinicalFacts:
    - 'Primary Action: Powerful hip extension (running, stair climbing, rising from chair); gluteus medius abducts and levels pelvis.'
    - "Innervation: Inferior and superior gluteal nerves (L4\u2013S2)."
    - Hypertrophy distinguishes hominid bipedal posture from all other primates.
  baseColor: {r: 0.82, g: 0.23999995, b: 0.37999994, a: 1}
  hoverColor: {r: 1, g: 1, b: 1, a: 1}
  selectedColor: {r: 1, g: 0.95, b: 0.2, a: 1}
  dimmedColor: {r: 0.25, g: 0.25, b: 0.25, a: 0.25}
  hasHeartbeatPulse: 0
  pulseSpeed: 1.2
  pulseMagnitude: 0.04
  explodedOffset: {x: -0.3, y: -0.1, z: -0.3}
