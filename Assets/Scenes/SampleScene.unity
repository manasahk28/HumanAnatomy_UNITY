  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HumanAnatomy.AnatomyPart
  data:
    partName: Right External Oblique
    scientificName: Musculus Obliquus Externus Dexter
    systemType: 7
    keyFunction: Broad flat superficial muscle forming lateral abdominal wall with downward/forward diagonal fiber orientation.
    description: "Originates from external surfaces of 5th\u201312th ribs; inserts onto iliac crest and anterior abdominal aponeurosis."
    clinicalFacts:
    - 'Primary Action: Bilaterally flexes trunk; unilaterally flexes and rotates trunk to opposite side.'
    - "Innervation: Lower intercostal nerves and subcostal nerve (T7\u2013T12)."
    - Inferior aponeurotic border folds back upon itself to form inguinal ligament (Poupart's ligament).
  baseColor: {r: 0.86, g: 0.35999998, b: 0.23999995, a: 1}
  hoverColor: {r: 1, g: 1, b: 1, a: 1}
