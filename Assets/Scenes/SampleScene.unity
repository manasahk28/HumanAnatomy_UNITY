  m_Script: {fileID: 11500000, guid: 6a92d41c1f18dfe44ad26397aa09c9ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HumanAnatomy.AnatomyPart
  data:
    partName: Left Hamstring Muscle Group
    scientificName: Musculi Ischiocrurales Sinistrum
    systemType: 7
    keyFunction: 'Three-muscle posterior thigh group: Biceps Femoris, Semitendinosus, and Semimembranosus.'
    description: Originates predominantly from ischial tuberosity of pelvis; inserts onto head of fibula and medial tibial condyle.
    clinicalFacts:
    - 'Primary Action: Primary knee flexor; secondary hip extensor during sprinting and walking stride.'
    - "Innervation: Sciatic nerve (Tibial & Common Fibular branches, L5\u2013S2)."
    - Hamstring strain injuries frequently occur during eccentric deceleration in high-speed sprinting.
  baseColor: {r: 0.74, g: 0.19999996, b: 0.24999997, a: 1}
  hoverColor: {r: 1, g: 1, b: 1, a: 1}
  selectedColor: {r: 1, g: 0.95, b: 0.2, a: 1}
  dimmedColor: {r: 0.25, g: 0.25, b: 0.25, a: 0.25}
  hasHeartbeatPulse: 0
  pulseSpeed: 1.2
  pulseMagnitude: 0.04
  explodedOffset: {x: -0.35, y: 0, z: -0.3}
