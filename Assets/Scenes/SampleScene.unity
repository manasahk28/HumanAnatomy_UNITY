  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HumanAnatomy.AnatomyPart
  data:
    partName: Right Brachial Plexus
    scientificName: Plexus Brachialis Dexter
    systemType: 5
    keyFunction: "Network of nerve fibers formed by ventral rami of spinal nerves C5\u2013T1 supplying upper extremity."
    description: Organized into Roots (C5-T1), Trunks (Superior, Middle, Inferior), Divisions, and Cords (Lateral, Posterior, Medial).
    clinicalFacts:
    - Passes between anterior and middle scalene muscles in posterior neck triangle.
    - Erb-Duchenne palsy involves upper trunk (C5-C6) avulsion ('waiter's tip' posture).
  baseColor: {r: 1, g: 0.92, b: 0.29999998, a: 1}
  hoverColor: {r: 1, g: 1, b: 1, a: 1}
