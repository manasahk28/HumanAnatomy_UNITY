  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HumanAnatomy.AnatomyPart
  data:
    partName: Right Radial Nerve
    scientificName: Nervus Radialis Dexter
    systemType: 5
    keyFunction: "Largest branch of brachial plexus (posterior cord, C5\u2013T1); supplies all extensor muscles of upper limb."
    description: Spirals around posterior shaft of humerus in radial groove; bifurcates at elbow into superficial sensory and deep posterior interosseous motor nerve.
    clinicalFacts:
    - 'Motor: Triceps brachii, brachioradialis, wrist and finger extensors.'
    - Injury (e.g. humeral mid-shaft fracture or 'Saturday night palsy') leads to classic 'wrist drop'.
  baseColor: {r: 1, g: 0.92, b: 0.29999998, a: 1}
  hoverColor: {r: 1, g: 1, b: 1, a: 1}
  selectedColor: {r: 0.2, g: 0.95, b: 1, a: 1}
