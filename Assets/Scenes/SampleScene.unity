  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6a92d41c1f18dfe44ad26397aa09c9ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HumanAnatomy.AnatomyPart
  data:
    partName: Right Sciatic Nerve
    scientificName: Nervus Ischiadicus Dexter
    systemType: 5
    keyFunction: "Largest and thickest nerve in the human body (~2 cm wide); derived from sacral plexus (L4\u2013S3)."
    description: Exits pelvis through greater sciatic foramen inferior to piriformis muscle; descends down posterior thigh before bifurcating at popliteal fossa.
    clinicalFacts:
    - Bifurcates into Tibial nerve and Common Fibular (Peroneal) nerve near knee.
    - 'Motor: Hamstring muscles and all muscles of the lower leg and foot.'
    - Sciatica causes radiating shooting pain, numbness, and tingling along posterior leg.
  baseColor: {r: 1, g: 0.85, b: 0.24999997, a: 1}
  hoverColor: {r: 1, g: 1, b: 1, a: 1}
  selectedColor: {r: 0.2, g: 0.95, b: 1, a: 1}
  dimmedColor: {r: 0.25, g: 0.25, b: 0.25, a: 0.25}
  hasHeartbeatPulse: 0
  pulseSpeed: 1.2
  pulseMagnitude: 0.04
  explodedOffset: {x: 0.35, y: 0, z: -0.3}
