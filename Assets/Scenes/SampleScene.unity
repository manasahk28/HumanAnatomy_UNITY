  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HumanAnatomy.AnatomyPart
  data:
    partName: Occipital Lobes (Visual Cortex)
    scientificName: Lobi Occipitales
    systemType: 5
    keyFunction: Posterior cerebral processing hub dedicated to visual perception, color discrimination, motion tracking, and spatial object recognition.
    description: Surrounds calcarine sulcus hosting the primary visual cortex (Brodmann Area 17 / Striate Cortex).
    clinicalFacts:
    - Receives retinotopic visual inputs from optic radiation via lateral geniculate nucleus.
    - Damage causes cortical blindness or visual agnosia.
  baseColor: {r: 0.7, g: 0.39999998, b: 0.85, a: 1}
