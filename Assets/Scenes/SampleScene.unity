  m_Script: {fileID: 11500000, guid: 6a92d41c1f18dfe44ad26397aa09c9ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HumanAnatomy.AnatomyPart
  data:
    partName: Right Femoral Nerve
    scientificName: Nervus Femoralis Dexter
    systemType: 5
    keyFunction: "Largest branch of lumbar plexus (L2\u2013L4); primary innervation of anterior thigh."
    description: Enters thigh deep to inguinal ligament lateral to femoral artery in femoral triangle; branches into muscular rami and saphenous sensory nerve.
    clinicalFacts:
    - 'Motor: Quadriceps femoris (knee extension), sartorius, pectineus.'
    - 'Sensory: Anterior thigh and medial lower leg/foot (saphenous nerve).'
    - Mediates patellar tendon knee-jerk reflex (L3-L4).
  baseColor: {r: 1, g: 0.85, b: 0.24999997, a: 1}
  hoverColor: {r: 1, g: 1, b: 1, a: 1}
  selectedColor: {r: 0.2, g: 0.95, b: 1, a: 1}
  dimmedColor: {r: 0.25, g: 0.25, b: 0.25, a: 0.25}
