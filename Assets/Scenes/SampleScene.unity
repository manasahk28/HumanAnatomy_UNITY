  m_EditorClassIdentifier: Assembly-CSharp::HumanAnatomy.AnatomyPart
  data:
    partName: Left Fibula
    scientificName: Fibula Sinistra
    systemType: 1
    keyFunction: Slender lateral stabilizing bone of leg anchoring muscles and reinforcing lateral ankle mortise.
    description: Non-weight-bearing long bone terminating distally as lateral malleolus (outer ankle).
    clinicalFacts:
    - Head articulates proximally with lateral tibial condyle below knee joint.
    - Commonly used as donor vascularized bone graft in reconstructive surgery.
