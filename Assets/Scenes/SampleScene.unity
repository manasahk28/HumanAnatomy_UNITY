  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HumanAnatomy.AnatomyPart
  data:
    partName: Thoracic Vertebrae (T1-T12)
    scientificName: Vertebrae Thoracicae
    systemType: 1
    keyFunction: Intermediate 12 vertebrae articulating with 12 pairs of ribs to enclose thoracic cage.
    description: Possesses costal facets for rib head and tubercle articulation; exhibits physiological kyphosis.
    clinicalFacts:
    - Long, downward-slanting spinous processes overlap like roof tiles.
    - Provides sturdy thoracic rigidity to protect heart and lungs.
  baseColor: {r: 0.49, g: 0.33999997, b: 0.76, a: 1}
