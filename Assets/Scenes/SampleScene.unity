  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HumanAnatomy.AnatomyPart
  data:
    partName: Left Patella (Kneecap)
    scientificName: Patella Sinistra
    systemType: 1
    keyFunction: Largest sesamoid bone in human skeleton, embedded within quadriceps femoris tendon.
    description: Increases mechanical leverage of quadriceps tendon during knee extension by 30%.
    clinicalFacts:
    - Articular posterior facets glide across femoral patellar groove.
    - Protects anterior knee joint capsule from traumatic impact.
  baseColor: {r: 1, g: 0.93, b: 0.34999996, a: 1}
