  m_EditorClassIdentifier: Assembly-CSharp::HumanAnatomy.AnatomyPart
  data:
    partName: Cerebellum (Little Brain)
    scientificName: Cerebellum
    systemType: 5
    keyFunction: Dorsal hindbrain structure maintaining motor coordination, precision rhythm, equilibrium, and procedural motor learning.
    description: Contains over 50% of the entire brain's neurons packed densely across cerebellar folia.
    clinicalFacts:
    - Composed of two lateral cerebellar hemispheres and central vermis.
    - Damage results in intention tremor, dysmetria, and cerebellar ataxia.
