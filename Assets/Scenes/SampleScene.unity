  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HumanAnatomy.AnatomyPart
  data:
    partName: Right Latissimus Dorsi
    scientificName: Musculus Latissimus Dorsi Dexter
    systemType: 7
    keyFunction: Broadest muscle of human back; triangular sheet creating the athletic 'V-taper' silhouette.
    description: "Originates from T7\u2013T12 spinous processes, thoracolumbar fascia, and iliac crest; wraps around to insert onto intertubercular groove of humerus."
    clinicalFacts:
    - 'Primary Action: Powerful arm extension, adduction, and internal rotation (''swimmer''s muscle'').'
    - "Innervation: Thoracodorsal nerve (C6\u2013C8)."
    - Crucial power generator for climbing, rowing, and pull-up biomechanics.
  baseColor: {r: 0.58, g: 0.17999998, b: 0.23999995, a: 1}
  hoverColor: {r: 1, g: 1, b: 1, a: 1}
  selectedColor: {r: 1, g: 0.95, b: 0.2, a: 1}
  dimmedColor: {r: 0.25, g: 0.25, b: 0.25, a: 0.25}
  hasHeartbeatPulse: 0
  pulseSpeed: 1.2
  pulseMagnitude: 0.04
  explodedOffset: {x: 0.35, y: 0, z: -0.3}
