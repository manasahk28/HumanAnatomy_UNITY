  data:
    partName: Left Clavicle (Collarbone)
    scientificName: Clavicula Sinistra
    systemType: 1
    keyFunction: S-shaped horizontal strut bracing upper extremity away from thoracic cage.
    description: Connects upper limb to axial skeleton via sternoclavicular and acromioclavicular joints.
    clinicalFacts:
    - Most commonly fractured long bone in the human body.
    - Subclavian artery and brachial plexus pass directly underneath.
  baseColor: {r: 0.14999998, g: 0.65, b: 0.6, a: 1}
