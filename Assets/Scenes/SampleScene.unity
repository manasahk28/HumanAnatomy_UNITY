  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HumanAnatomy.AnatomyPart
  data:
    partName: Facial Skeleton (Viscerocranium)
    scientificName: Skeleton Faciale
    systemType: 1
    keyFunction: Anterior skull framework supporting eyes, nasal passageway, cheeks, and upper dentition.
    description: 'Comprises 14 facial bones: maxillae, zygomatics, nasals, lacrimals, palatines, vomer, and conchae.'
    clinicalFacts:
    - Bilateral orbital sockets shelter the eyes and oculomotor apparatus.
    - Zygomatic arches (cheekbones) withstand intense bite forces.
