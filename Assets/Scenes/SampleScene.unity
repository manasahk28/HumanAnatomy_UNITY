  m_Script: {fileID: 11500000, guid: 6a92d41c1f18dfe44ad26397aa09c9ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HumanAnatomy.AnatomyPart
  data:
    partName: Right Deltoid
    scientificName: Musculus Deltoideus Dexter
    systemType: 7
    keyFunction: Triangular multipennate muscle cap wrapping the glenohumeral shoulder articulation.
    description: Originates from lateral clavicle, acromion, and spine of scapula; converges into deltoid tuberosity on lateral humeral shaft.
    clinicalFacts:
    - "Primary Action: Prime mover of shoulder abduction (15\xB0 to 90\xB0); anterior head flexes, posterior head extends."
    - "Innervation: Axillary nerve (C5\u2013C6)."
    - Common intramuscular injection site.
  baseColor: {r: 0.95, g: 0.41999996, b: 0.21999997, a: 1}
  hoverColor: {r: 1, g: 1, b: 1, a: 1}
  selectedColor: {r: 1, g: 0.95, b: 0.2, a: 1}
  dimmedColor: {r: 0.25, g: 0.25, b: 0.25, a: 0.25}
  hasHeartbeatPulse: 0
  pulseSpeed: 1.2
  pulseMagnitude: 0.04
  explodedOffset: {x: 0.38, y: 0.15, z: 0}
