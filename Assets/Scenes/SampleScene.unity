  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HumanAnatomy.AnatomyPart
  data:
    partName: Neurocranium (Cranial Vault)
    scientificName: Calvaria
    systemType: 1
    keyFunction: Rigid protective enclosure sheltering the cerebral hemispheres, cerebellum, and brainstem.
    description: Formed by 8 cranial bones united by coronal, sagittal, and lambdoid sutures.
    clinicalFacts:
    - Houses the cerebrum and protects against traumatic impact.
    - Foramen magnum at skull base allows spinal cord transition.
