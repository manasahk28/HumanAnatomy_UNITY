  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HumanAnatomy.AnatomyPart
  data:
    partName: Left Hip Bone (Os Coxae)
    scientificName: Os Coxae Sinistrum
    systemType: 1
    keyFunction: Forms left lateral and anterior pelvic girdle wall; transfers body weight to lower extremity.
    description: Formed by fusion of ilium (superior blade), ischium (inferoposterior), and pubis (anteromedial).
    clinicalFacts:
    - Acetabulum cup articulates with femoral head in a deep ball-and-socket joint.
    - Iliac crest provides essential attachment for abdominal and gluteal muscles.
