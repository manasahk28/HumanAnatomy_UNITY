  m_Script: {fileID: 11500000, guid: 6a92d41c1f18dfe44ad26397aa09c9ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HumanAnatomy.AnatomyPart
  data:
    partName: Left Common Fibular (Peroneal) Nerve
    scientificName: Nervus Fibularis Communis Sinister
    systemType: 5
    keyFunction: "Lateral branch of sciatic nerve (L4\u2013S2) curving superficially around the lateral neck of fibula."
    description: Bifurcates into superficial fibular (fibularis longus/brevis) and deep fibular nerve (anterior compartment muscles).
    clinicalFacts:
    - 'Motor: Tibialis anterior (foot dorsiflexion), extensor digitorum longus, extensor hallucis.'
    - Compression or trauma at neck of fibula results in 'Foot Drop' (loss of dorsiflexion and high-stepping gait).
  baseColor: {r: 1, g: 0.85, b: 0.24999997, a: 1}
  hoverColor: {r: 1, g: 1, b: 1, a: 1}
  selectedColor: {r: 0.2, g: 0.95, b: 1, a: 1}
  dimmedColor: {r: 0.25, g: 0.25, b: 0.25, a: 0.25}
  hasHeartbeatPulse: 0
  pulseSpeed: 1.2
  pulseMagnitude: 0.04
  explodedOffset: {x: -0.45, y: 0, z: 0.1}
