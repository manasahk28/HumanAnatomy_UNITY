  m_Script: {fileID: 11500000, guid: 6a92d41c1f18dfe44ad26397aa09c9ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HumanAnatomy.AnatomyPart
  data:
    partName: Left Quadriceps Femoris
    scientificName: Musculus Quadriceps Femoris Sinister
    systemType: 7
    keyFunction: Massive four-headed muscle filling anterior thigh compartment.
    description: Composed of Rectus Femoris, Vastus Lateralis, Vastus Medialis, and Vastus Intermedius; converges onto patella and tibial tuberosity via patellar tendon.
    clinicalFacts:
    - 'Primary Action: Sole major extensor of knee joint; rectus femoris also assists hip flexion.'
    - "Innervation: Femoral nerve (L2\u2013L4)."
    - Vastus medialis oblique (VMO) stabilizes patellar tracking during final extension.
  baseColor: {r: 0.93, g: 0.25999996, b: 0.21999997, a: 1}
  hoverColor: {r: 1, g: 1, b: 1, a: 1}
  selectedColor: {r: 1, g: 0.95, b: 0.2, a: 1}
  dimmedColor: {r: 0.25, g: 0.25, b: 0.25, a: 0.25}
  hasHeartbeatPulse: 0
  pulseSpeed: 1.2
  pulseMagnitude: 0.04
  explodedOffset: {x: -0.35, y: 0, z: 0.3}
