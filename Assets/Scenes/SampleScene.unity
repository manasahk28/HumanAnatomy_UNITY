  m_Script: {fileID: 11500000, guid: 6a92d41c1f18dfe44ad26397aa09c9ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HumanAnatomy.AnatomyPart
  data:
    partName: Left Forearm Muscle Compartment
    scientificName: Musculi Antebrachii Sinistrum
    systemType: 7
    keyFunction: Dense complex of anterior flexor-pronator and posterior extensor-supinator muscle groups.
    description: Originates from medial/lateral humeral epicondyles; extends tendons across carpal tunnel and extensor retinaculum to hand digits.
    clinicalFacts:
    - 'Primary Action: Controls wrist articulation, forearm pronation/supination, and delicate finger grip dexterity.'
    - 'Innervation: Median, Ulnar, and Radial nerves.'
    - Includes brachioradialis, flexor carpi radialis, extensor digitorum.
  baseColor: {r: 0.82, g: 0.43999997, b: 0.31999996, a: 1}
  hoverColor: {r: 1, g: 1, b: 1, a: 1}
  selectedColor: {r: 1, g: 0.95, b: 0.2, a: 1}
