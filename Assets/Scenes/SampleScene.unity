  m_EditorClassIdentifier: Assembly-CSharp::HumanAnatomy.AnatomyPart
  data:
    partName: Spinal Cord (Neural Canal)
    scientificName: Medulla Spinalis
    systemType: 1
    keyFunction: Cylindrical central nerve bundle traversing vertebral canal from brainstem to conus medullaris.
    description: Transmits afferent sensory and efferent motor information; mediates autonomous somatic reflexes.
    clinicalFacts:
    - Gives rise to 31 bilateral pairs of spinal nerves.
    - Terminates near L1-L2 vertebra level, continuing as cauda equina fibers.
  baseColor: {r: 1, g: 0.8399999, b: 0.30999997, a: 1}
