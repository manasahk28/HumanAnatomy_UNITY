  m_Script: {fileID: 11500000, guid: 6a92d41c1f18dfe44ad26397aa09c9ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HumanAnatomy.AnatomyPart
  data:
    partName: Parietal Lobes (Left & Right)
    scientificName: Lobi Parietales
    systemType: 5
    keyFunction: Primary somatosensory integration center processing somatic sensations (touch, pain, temperature, proprioception) and spatial coordinates.
    description: Houses the primary somatosensory cortex (postcentral gyrus) and sensory homunculus representation.
    clinicalFacts:
    - Integrates multimodal sensory cues into a cohesive spatial map.
    - Lesions in non-dominant parietal lobe produce hemispatial neglect syndrome.
  baseColor: {r: 0.95, g: 0.45, b: 0.45, a: 1}
  hoverColor: {r: 1, g: 1, b: 1, a: 1}
