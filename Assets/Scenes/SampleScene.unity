  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6a92d41c1f18dfe44ad26397aa09c9ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HumanAnatomy.AnatomyPart
  data:
    partName: Cauda Equina (Lumbar & Sacral Nerve Roots)
    scientificName: Cauda Equina
    systemType: 5
    keyFunction: Sheaf of lumbar, sacral, and coccygeal nerve roots descending vertically within the lumbar cistern below conus medullaris.
    description: Enclosed in dural sac with cerebrospinal fluid (CSF); prime location for clinical lumbar puncture (spinal tap at L3/L4 or L4/L5).
    clinicalFacts:
    - Cauda equina syndrome is a surgical emergency characterized by saddle anesthesia and bladder/bowel incontinence.
    - Supplies pelvic floor, sphincters, and all lower extremity musculature.
  baseColor: {r: 1, g: 0.88, b: 0.19999996, a: 1}
  hoverColor: {r: 1, g: 1, b: 1, a: 1}
  selectedColor: {r: 0.2, g: 0.95, b: 1, a: 1}
  dimmedColor: {r: 0.25, g: 0.25, b: 0.25, a: 0.25}
