  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HumanAnatomy.AnatomyPart
  data:
    partName: Left Humerus
    scientificName: Humerus Sinistrum
    systemType: 1
    keyFunction: Long bone of upper arm articulating proximally at shoulder and distally at elbow joint.
    description: Features hemispherical head, greater/lesser tubercles, deltoid tuberosity, and distal condyles.
    clinicalFacts:
    - Distal trochlea articulates with ulna; capitulum articulates with radial head.
    - Radial groove accommodates radial nerve along posterior mid-shaft.
  baseColor: {r: 1, g: 0.65, b: 0.14999998, a: 1}
