  m_Script: {fileID: 11500000, guid: 6a92d41c1f18dfe44ad26397aa09c9ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HumanAnatomy.AnatomyPart
  data:
    partName: Rib Cage (12 Pairs of Costae)
    scientificName: Cavea Thoracis (Costae I-XII)
    systemType: 1
    keyFunction: Bilateral curved thoracic bone arches enclosing thoracic cavity; articulates with spine and sternum.
    description: Divided into 7 true ribs (vertebrosternal), 3 false ribs (vertebrochondral), and 2 floating ribs.
    clinicalFacts:
    - Intercostal spaces contain muscles, arteries, veins, and nerves for respiration.
    - Elastic costal cartilages enable volumetric chest expansion during breathing.
  baseColor: {r: 1, g: 0.43999997, b: 0.25999996, a: 1}
  hoverColor: {r: 1, g: 1, b: 1, a: 1}
