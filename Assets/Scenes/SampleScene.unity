  m_Script: {fileID: 11500000, guid: 6a92d41c1f18dfe44ad26397aa09c9ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HumanAnatomy.AnatomyPart
  data:
    partName: Left Gastrocnemius and Soleus (Calf)
    scientificName: Musculus Triceps Surae Sinister
    systemType: 7
    keyFunction: Two-part posterior leg complex uniting into the calcaneal tendon (Achilles tendon).
    description: Gastrocnemius originates from femoral condyles (two superficial heads); deep soleus originates from posterior tibia/fibula; unites into Achilles tendon inserting onto calcaneus.
    clinicalFacts:
    - 'Primary Action: Prime mover of foot plantar flexion; crucial for propulsion in running, jumping, and bipedal gait.'
    - "Innervation: Tibial nerve (S1\u2013S2)."
    - Soleus is heavily rich in slow-twitch fibers for postural anti-gravity endurance.
  baseColor: {r: 0.88, g: 0.27999997, b: 0.25999996, a: 1}
  hoverColor: {r: 1, g: 1, b: 1, a: 1}
  selectedColor: {r: 1, g: 0.95, b: 0.2, a: 1}
  dimmedColor: {r: 0.25, g: 0.25, b: 0.25, a: 0.25}
  hasHeartbeatPulse: 0
