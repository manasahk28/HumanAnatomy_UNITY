  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HumanAnatomy.AnatomyPart
  data:
    partName: Right Radius
    scientificName: Radius Dextrum
    systemType: 1
    keyFunction: Lateral forearm long bone rotating around ulna to achieve forearm pronation and supination.
    description: Features cylindrical head, radial tuberosity, and broadened distal styloid process.
    clinicalFacts:
    - Distal articular surface forms radiocarpal joint with scaphoid and lunate wrist bones.
    - Colles' fracture of distal radius is one of most common orthopedic injuries.
  baseColor: {r: 0.61, g: 0.8, b: 0.39999998, a: 1}
  hoverColor: {r: 1, g: 1, b: 1, a: 1}
