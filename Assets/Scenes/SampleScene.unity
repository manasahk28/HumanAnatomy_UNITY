  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HumanAnatomy.AnatomyPart
  data:
    partName: Left Hand and Finger Bones
    scientificName: Ossa Manus Sinistra
    systemType: 1
    keyFunction: 'Complex manipulative structure comprising 27 bones: 8 carpals, 5 metacarpals, and 14 phalanges.'
    description: Arranged into wrist, palm, and five multi-jointed digital ray columns.
    clinicalFacts:
    - 'Carpal bones: scaphoid, lunate, triquetrum, pisiform, trapezium, trapezoid, capitate, hamate.'
    - Thumb (pollex) features opposable saddle carpometacarpal joint enabling human tool grasp.
  baseColor: {r: 1, g: 0.72, b: 0.29999998, a: 1}
  hoverColor: {r: 1, g: 1, b: 1, a: 1}
