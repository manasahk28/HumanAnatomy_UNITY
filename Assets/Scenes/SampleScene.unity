  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HumanAnatomy.AnatomyPart
  data:
    partName: Left Ulna
    scientificName: Ulna Sinistra
    systemType: 1
    keyFunction: Medial forearm stabilizing long bone forming primary hinge component of elbow joint.
    description: Prominent olecranon process hooks into humeral olecranon fossa to prevent hyperextension.
    clinicalFacts:
    - Trochlear notch forms sturdy hinge articulation with humeral trochlea.
    - Distal head features small styloid process non-articular with carpal bones directly.
  baseColor: {r: 0.39999998, g: 0.73, b: 0.41999996, a: 1}
