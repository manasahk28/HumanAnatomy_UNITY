  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HumanAnatomy.AnatomyPart
  data:
    partName: Right Triceps Brachii
    scientificName: Musculus Triceps Brachii Dexter
    systemType: 7
    keyFunction: Three-headed muscle occupying entire posterior compartment of upper arm.
    description: Originates from infraglenoid tubercle (long head) and posterior humeral shaft (lateral & medial heads); inserts onto olecranon process of ulna.
    clinicalFacts:
    - 'Primary Action: Sole major extensor of elbow joint; long head stabilizes abducted shoulder.'
    - "Innervation: Radial nerve (C6\u2013C8)."
    - Antagonist to biceps brachii and brachialis.
  baseColor: {r: 0.72, g: 0.17999998, b: 0.25999996, a: 1}
  hoverColor: {r: 1, g: 1, b: 1, a: 1}
  selectedColor: {r: 1, g: 0.95, b: 0.2, a: 1}
